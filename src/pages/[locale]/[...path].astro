---
import {Picture} from 'astro:assets';
import hero from '../../assets/connected-systems.png';
import Site from '../../layouts/Site.astro';
import {records,href,page,articles,type Translation} from '../../lib/content';
import {safeHtml} from '../../lib/sanitize.mjs';
export function getStaticPaths() {
  const paths=records.filter(r=>r.key!=='shell').map(item=>({
    params:{locale:item.locale,path:item.kind==='article'?'blog/'+item.slug:item.key==='home'?undefined:item.slug},
    props:{item,current:1,category:undefined as string|undefined}
  }));
  for(const item of records.filter(r=>r.key==='blog')) {
    const all=articles(item.locale);
    for(let n=2;n<=Math.ceil(all.length/12);n++) paths.push({params:{locale:item.locale,path:'blog/page/'+n},props:{item,current:n,category:undefined}});
    for(const category of [...new Set(all.map(a=>a.data.category).filter(Boolean))] as string[]) {
      const categoryKey=encodeURIComponent(category);
      for(let n=1;n<=Math.max(1,Math.ceil(all.filter(a=>a.data.category===category).length/12));n++) paths.push({
        params:{locale:item.locale,path:'blog/category/'+categoryKey+(n>1?'/page/'+n:'')},props:{item,current:n,category}
      });
    }
  }
  return paths;
}
interface Props {item:Translation;current:number;category?:string}
const {item,current=1,category}=Astro.props as Props;
const ui=page('shell',item.locale).data.ui;
const all=articles(item.locale);
const filtered=category?all.filter(a=>a.data.category===category):all;
const shown=filtered.slice((current-1)*12,current*12);
const total=Math.ceil(filtered.length/12);
const listBase='/'+item.locale+'/blog/'+(category?'category/'+encodeURIComponent(category)+'/':'');
const date=(value:string)=>new Intl.DateTimeFormat(item.locale,{dateStyle:'long',timeZone:'UTC'}).format(new Date(value));
---
<Site item={item} canonicalPath={Astro.url.pathname}>
  {item.key==='home'?<>
    <section class="hero">
      <div class="hero-copy"><p class="eyebrow">{item.data.eyebrow}</p><h1>{item.title}</h1><p class="lead">{item.description}</p>
        <div class="actions"><a class="button" href={href(page('expertise',item.locale))}>{item.data.primary}<span aria-hidden="true">↗</span></a><a class="text-link" href={href(page('contact',item.locale))}>{item.data.secondary}</a></div>
      </div>
      <div class="hero-art"><Picture src={hero} formats={['avif']} fallbackFormat="webp" widths={[640,960,1440,1920]} sizes="100vw" width={1920} alt="" loading="eager" fetchpriority="high" /></div>
      <div class="hero-bottom" aria-hidden="true"><span>AVANTI COMPLEX</span><span>{ui.footer}</span></div>
    </section>
    <section class="intro section"><div class="intro-index"><span class="eyebrow">01 / AVANTI</span><span class="large-index" aria-hidden="true">A.</span></div><div><h2>{item.data.intro[0]}</h2><p>{item.data.intro[1]}</p></div></section>
    <section class="cards section" aria-label={page('expertise',item.locale).title}>
      {item.data.cards.map((card:string[],i:number)=><a class={'service-card service-'+i} href={href(page(card[0],item.locale))}><div class="card-top"><span class="eyebrow">{card[1]}</span><span class="card-number" aria-hidden="true">0{i+1}</span></div><h3>{card[2]}</h3><p>{card[3]}</p><span class="card-link">{ui.more} <span aria-hidden="true">↗</span></span></a>)}
    </section>
  </>:<>
    <section class="page-heading section"><p class="eyebrow">AVANTI / {item.kind==='article'?page('blog',item.locale).title:page('shell',item.locale).data.ui.footer.split(' · ')[0]}</p><h1>{category||item.title}</h1><p class="lead">{item.description}</p>
      {item.kind==='article'&&<p class="byline">{item.data.author && <span>{item.data.author} · </span>}<time datetime={item.published_at}>{date(item.published_at)}</time>{item.data.category&&<span> · {item.data.category}</span>}</p>}
    </section>
    {item.key==='blog'?<section class="section blog-list">
      <nav class="categories" aria-label={ui.related}><a href={href(item)} aria-current={!category?'page':undefined}>{ui.back}</a>{([...new Set(all.map(a=>a.data.category).filter(Boolean))] as string[]).map(c=><a href={'/'+item.locale+'/blog/category/'+encodeURIComponent(c)+'/'} aria-current={c===category?'page':undefined}>{c}</a>)}</nav>
      {shown.length?shown.map(post=><article class="article-card"><time datetime={post.published_at}>{date(post.published_at)}</time><div><h2><a href={href(post)}>{post.title}</a></h2><p>{post.description}</p><a class="text-link" href={href(post)}>{ui.read}</a></div></article>):<div class="empty"><p>{ui.empty}</p></div>}
      {total>1&&<nav class="pagination" aria-label={ui.page}>{current>1&&<a href={current===2?listBase:listBase+'page/'+(current-1)+'/'}>{ui.previous}</a>}<span>{ui.page} {current} / {total}</span>{(current < total) &&<a href={listBase+'page/'+(current+1)+'/'}>{ui.next}</a>}</nav>}
    </section>:<section class="section article-body"><div class="prose" set:html={safeHtml(item.body)} />
      {item.key==='contact'&&<a class="button" href="mailto:innovator@avanticomplex.com">{ui.email} <span aria-hidden="true">↗</span></a>}
      {item.kind==='article'&&<a class="text-link" href={href(page('blog',item.locale))}>{ui.back}</a>}
    </section>}
    {['expertise','consulting','development'].includes(item.key)&&<aside class="contact-strip section"><h2>{page('contact',item.locale).title}</h2><a class="button" href={href(page('contact',item.locale))}>{ui.email}</a></aside>}
  </>}
</Site>



