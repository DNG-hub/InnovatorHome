{
  "name": "avanti-ai-innovators",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 3204",
    "check": "astro check",
    "build": "npm run content:export && astro check && astro build",
    "preview": "node scripts/serve.mjs",
    "db:migrate": "node scripts/content.mjs migrate",
    "db:seed": "node scripts/content.mjs seed",
    "content:export": "node scripts/content.mjs export",
    "content:save": "node scripts/content.mjs save",
    "content:import-legacy": "node scripts/content.mjs import-legacy",
    "test": "node --test tests/*.test.mjs",
    "setup:local": "node scripts/init-local.mjs",
    "content:list": "node scripts/content.mjs list",
    "content:get": "node scripts/content.mjs get",
    "db:backup": "node scripts/backup.mjs",
    "test:db": "node tests/database.integration.mjs",
    "test:site": "node tests/http.mjs"
  },
  "dependencies": {
    "astro": "^7.3.2",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "node": "^24.21.0",
    "typescript": "^6.0.3"
  }
}
