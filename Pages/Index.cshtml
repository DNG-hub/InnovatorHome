@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome to Our Business";
}

<meta name="current-page" content="index" />

<div class="index-page-background">
    <div class="index-page-content">
        <h1 class="display-4 bold-text" data-location="home_header_1">The AI Train is Leaving the Station</h1>
        <h1 class="display-4 slanted-text" data-location="home_header_2">All Aboard with Avanti AI Innovators!</h1>
        <p data-location="home_intro_paragraph" style="color: white; text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.7); text-align: center; margin: 20px 0;">
            Join us on a journey to transform your business with cutting-edge AI solutions. Explore agentic workflows, AI consultation, and tools designed to enhance productivity and market reach. Let's embark on this innovation adventure together!
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <h2 data-location="home_services_header">Our Services</h2>
        <p data-location="home_services_paragraph">
            Avanti AI Innovators offers comprehensive AI solutions, including agentic workflows, AI consultation, and advanced tools designed to enhance business productivity, market reach, and overall efficiency.
            <br><br>
            <a href="/WhatWeDo" class="btn btn-primary" data-location="home_services_button">What We Do</a>
        </p>
    </div>
    <div class="col-md-4">
        <h2>About Us</h2>
        <p>
            Brief introduction about your company.
        </p>
    </div>
    <div class="col-md-4">
        <h2 data-location="home_contact_header">Contact</h2>
        <p data-location="home_contact_paragraph">
            Reach out to us for inquiries and support. We are here to help you explore the possibilities of AI and transform your business operations.
            <br><br>
            <a href="/ContactUs" class="btn btn-primary" data-location="home_contact_button">Contact Us</a>
        </p>
    </div>
</div>
