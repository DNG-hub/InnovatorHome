@page
@model InnovatorHome.Pages.WhatWeDoModel
@{
    ViewData["Title"] = "WhatWeDo"; // Single-word title
}

<div class="container mt-5">
    <section id="introduction" class="mb-5" data-location="whatwedo_introduction_section">
        <h1 data-location="whatwedo_introduction_header_1">Welcome to Avanti AI Innovators</h1>
        <p data-location="whatwedo_introduction_paragraph_1">At Avanti AI Innovators, we harness the power of artificial intelligence to drive innovation and deliver exceptional results for our clients. Our dedicated team of experts ensures that our solutions are tailored to meet your unique business needs.</p>
    </section>

    <section id="services" class="mb-5" data-location="whatwedo_services_section">
        <h2 data-location="whatwedo_services_header_1">Our Services</h2>

        <div id="consulting" class="mb-3" data-location="whatwedo_services_consulting">
            <h3 data-location="whatwedo_services_consulting_header_1">Consulting</h3>
            <p data-location="whatwedo_services_consulting_paragraph_1">We provide expert consulting services to help you navigate the complexities of AI.</p>
            <a href="#consulting-details" class="read-more" data-location="whatwedo_services_consulting_readmore_1">Read More</a>
            <div id="consulting-details" class="details d-none" data-location="whatwedo_services_consulting_details_1">
                <p data-location="whatwedo_services_consulting_details_paragraph_1">Our consulting services include AI strategy development, data analysis, and custom solution design to ensure you get the most out of your AI initiatives.</p>
            </div>
        </div>

        <div id="ai-development" class="mb-3" data-location="whatwedo_services_aidevelopment">
            <h3 data-location="whatwedo_services_aidevelopment_header_1">AI Development</h3>
            <p data-location="whatwedo_services_aidevelopment_paragraph_1">Our team develops cutting-edge AI solutions tailored to your business needs.</p>
            <a href="#ai-development-details" class="read-more" data-location="whatwedo_services_aidevelopment_readmore_1">Read More</a>
            <div id="ai-development-details" class="details d-none" data-location="whatwedo_services_aidevelopment_details_1">
                <p data-location="whatwedo_services_aidevelopment_details_paragraph_1">We specialize in creating custom AI models, machine learning algorithms, and data-driven applications to enhance your operations and drive growth.</p>
            </div>
        </div>

        <div id="integration" class="mb-3" data-location="whatwedo_services_integration">
            <h3 data-location="whatwedo_services_integration_header_1">Integration</h3>
            <p data-location="whatwedo_services_integration_paragraph_1">Seamlessly integrate AI technologies into your existing systems.</p>
            <a href="#integration-details" class="read-more" data-location="whatwedo_services_integration_readmore_1">Read More</a>
            <div id="integration-details" class="details d-none" data-location="whatwedo_services_integration_details_1">
                <p data-location="whatwedo_services_integration_details_paragraph_1">Our integration services include system architecture design, API development, and deployment to ensure smooth and efficient integration of AI solutions.</p>
            </div>
        </div>

        <div id="support-maintenance" class="mb-3" data-location="whatwedo_services_supportmaintenance">
            <h3 data-location="whatwedo_services_supportmaintenance_header_1">Support and Maintenance</h3>
            <p data-location="whatwedo_services_supportmaintenance_paragraph_1">Ongoing support and maintenance to ensure your AI solutions remain effective.</p>
            <a href="#support-maintenance-details" class="read-more" data-location="whatwedo_services_supportmaintenance_readmore_1">Read More</a>
            <div id="support-maintenance-details" class="details d-none" data-location="whatwedo_services_supportmaintenance_details_1">
                <p data-location="whatwedo_services_supportmaintenance_details_paragraph_1">We offer comprehensive support, troubleshooting, and regular updates to keep your AI systems running smoothly.</p>
            </div>
        </div>
    </section>

    <section id="case-studies" class="mb-5" data-location="whatwedo_casestudies_section">
        <h2 data-location="whatwedo_casestudies_header_1">Case Studies</h2>

        <div class="case-study mb-3" data-location="whatwedo_casestudies_case1">
            <h3 data-location="whatwedo_casestudies_case1_header_1">Success Story 1</h3>
            <p data-location="whatwedo_casestudies_case1_paragraph_1">Learn how we helped a leading retail company...</p>
            <a href="case-study1.html" data-location="whatwedo_casestudies_case1_readmore_1">Read More</a>
        </div>

        <div class="case-study mb-3" data-location="whatwedo_casestudies_case2">
            <h3 data-location="whatwedo_casestudies_case2_header_1">Success Story 2</h3>
            <p data-location="whatwedo_casestudies_case2_paragraph_1">Discover our innovative solutions for a healthcare provider...</p>
            <a href="case-study2.html" data-location="whatwedo_casestudies_case2_readmore_1">Read More</a>
        </div>
    </section>

    <section id="testimonials" class="mb-5" data-location="whatwedo_testimonials_section">
        <h2 data-location="whatwedo_testimonials_header_1">Client Testimonials</h2>

        <div class="testimonial mb-3" data-location="whatwedo_testimonials_testimonial1">
            <p data-location="whatwedo_testimonials_testimonial1_quote_1">"Avanti AI Innovators transformed our business with their AI solutions."</p>
            <p data-location="whatwedo_testimonials_testimonial1_client_1">- Client Name, Company</p>
        </div>

        <div class="testimonial mb-3" data-location="whatwedo_testimonials_testimonial2">
            <p data-location="whatwedo_testimonials_testimonial2_quote_1">"Their expertise and support have been invaluable."</p>
            <p data-location="whatwedo_testimonials_testimonial2_client_1">- Client Name, Company</p>
        </div>
    </section>
</div>

}
