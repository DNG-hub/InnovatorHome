@model InnovatorHome.Pages.Shared.BlogSidebarModel

<div class="blog-sidebar">
    <h3>Categories</h3>
    <ul class="list-unstyled">
        @foreach (var category in Model.Categories)
        {
            <li>
                <a href="#" class="sidebar-link category-link" data-category-id="@category.Id">
                    @category.Name
                </a>
            </li>
        }
    </ul>

    <h3>Recent Posts</h3>
    <ul class="list-unstyled">
        @foreach (var post in Model.RecentPosts)
        {
            <li>
                <a href="#" class="sidebar-link post-link" data-post-id="@post.Id">
                    @post.Title
                </a>
            </li>
        }
    </ul>
</div>